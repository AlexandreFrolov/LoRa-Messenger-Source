[Unit]
Description=LoRa E22 web chat (e22_web_chat.py)
After=network.target
# Раскомментируйте, если хотите, чтобы сервис ждал появления USB-устройства
# перед стартом (нужен udev-symlink, см. примечание ниже):
# After=dev-e22.device
# BindsTo=dev-e22.device

[Service]
Type=simple
# Замените на реального пользователя (должен быть в группе dialout)
User=frolov
Group=frolov
WorkingDirectory=/home/frolov/lora-web-chat

# Пример для адресного режима с RSSI на канале 19, узел-собеседник 0x0002.
# Подставьте свой /dev/ttyUSB* или, лучше, устойчивое имя из /dev/serial/by-id/.
ExecStart=/usr/bin/python3 /home/frolov/lora-web-chat/e22_web_chat.py \
    --port /dev/ttyUSB0 \
    --baud 9600 \
    --peer-address 0x0001 \
    --channel 19 \
    --rssi \
    --web-host 0.0.0.0 \
    --web-port 5000

Restart=on-failure
RestartSec=3

# Небольшое ужесточение (по желанию, можно убрать при проблемах с доступом к /dev)
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
